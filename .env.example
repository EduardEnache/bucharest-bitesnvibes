# ─── DATABASE ───────────────────────────────────────────────
DATABASE_URL="postgresql://bites_user:bites_password@db:5432/bites_vibes"

# ─── NEXTAUTH ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
# Set to your domain once Cloudflare tunnel is configured
# For local dev use: http://localhost:3000
NEXTAUTH_URL="https://your-domain.com"

# ─── GOOGLE OAUTH ───────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Add Authorized redirect URI: https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── GOOGLE MAPS & PLACES API ───────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# Enable: Maps JavaScript API, Places API, Geocoding API
# Restrict key to your domain for security
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
GOOGLE_MAPS_SERVER_KEY="your-google-maps-server-key"

# ─── ACCESS CONTROL ─────────────────────────────────────────
# Comma-separated list of Google account emails allowed to log in
WHITELISTED_EMAILS="your-email@gmail.com,friend@gmail.com"

# ─── CLOUDFLARE TUNNEL ──────────────────────────────────────
# Create tunnel at: https://one.dash.cloudflare.com/
# Go to Access > Tunnels > Create Tunnel > Copy token
CLOUDFLARE_TUNNEL_TOKEN="your-cloudflare-tunnel-token"

# ─── POSTGRES (for docker-compose) ──────────────────────────
POSTGRES_USER="bites_user"
POSTGRES_PASSWORD="bites_password"
POSTGRES_DB="bites_vibes"
